# Copy this file to ".env.local" for local work with "vercel dev".
# NEVER commit the real file. On Vercel, set these in Project Settings -> Environment Variables.
# These variables are read ONLY by the serverless function in api/chat.ts.
# They must NOT start with VITE_ (variables with that prefix are shipped to the browser).

# The AI assistant needs a key from ONE of these providers. Without any key the app still works;
# the assistant just shows "not available". If several are set, the first free one is used.

# 1) Google Gemini - free tier, no credit card. Get a key at https://aistudio.google.com (Get API key).
#    Note: Google may use free-tier content to improve its products. Do not type personal data.
GEMINI_API_KEY=

# 2) Groq - free tier. Get a key at https://console.groq.com (API Keys).
GROQ_API_KEY=

# 3) Anthropic - paid. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: force one provider (gemini | groq | anthropic) when more than one key is set.
AI_PROVIDER=

# Optional: model name override. Leave empty to use each provider's default
# (gemini-2.5-flash, openai/gpt-oss-120b, claude-sonnet-5-5).
AI_MODEL=
